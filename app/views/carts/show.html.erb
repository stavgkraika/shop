<section class="section" aria-labelledby="cart-heading">
  <h1 id="cart-heading" class="title">Your cart</h1>

  <% if @cart.cart_items.any? %>
    <div class="table-container">
      <table class="table is-fullwidth">
        <thead>
          <tr>
            <th scope="col">Product</th>
            <th scope="col">Quantity</th>
            <th scope="col">Item total</th>
            <th scope="col"><span class="is-sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @cart.cart_items.includes(:product).each do |item| %>
            <tr>
              <td><%= link_to item.product.title, item.product %></td>
              <td><%= item.quantity %></td>
              <td><%= number_to_currency(item.total_price) %></td>
              <td>
                <%= button_to "Remove one",
                              cart_item_path(item),
                              method: :patch,
                              class: "button is-small",
                              form: { class: "is-inline-block" } %>
                <%= button_to "Remove item",
                              cart_item_path(item),
                              method: :delete,
                              class: "button is-small is-danger",
                              form: { class: "is-inline-block" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Total</th>
            <td><%= @cart.total_quantity %></td>
            <td><%= number_to_currency(@cart.total_price) %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <%= button_to "Empty cart",
                  cart_path,
                  method: :delete,
                  class: "button is-danger" %>
  <% else %>
    <p>Your cart is empty.</p>
    <%= link_to "Continue shopping", root_path, class: "button is-link mt3" %>
  <% end %>
</section>
